# --- Base de datos (obligatoria: las solicitudes se guardan aquí) ---
DATABASE_URL=postgres://postgres@localhost:5432/football_club

# --- Panel /admin (obligatorio para gestionar solicitudes; si falta, el panel queda desactivado) ---
# Genera uno con: openssl rand -hex 24
ADMIN_TOKEN=

# --- Sal para anonimizar la IP en el control de abuso (cualquier cadena larga y aleatoria) ---
IP_HASH_SALT=cambia-esto-por-algo-largo-y-aleatorio

# --- Correo (opcional). Sin SMTP_HOST el modo desarrollo solo lo registra en consola ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Club <no-reply@tudominio.com>"
# Dónde llegan los avisos de nuevas solicitudes
NOTIFY_TO=

# --- URL pública (sitemap, Open Graph) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
